    <IsTestProject>true</IsTestProject>
    <RootNamespace>Launcher.Tests</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector">
